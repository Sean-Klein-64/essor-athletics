      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "B9PZPU9HW5",
        "appleId": "TODO-your-apple-id@example.com",
        "ascAppId": "TODO-from-App-Store-Connect",
        "language": "fr-FR",
        "companyName": "CrossFit Essor"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "completed",
        "serviceAccountKeyPath": "./google-play-service-account.json"
      }
    }
  }
}
